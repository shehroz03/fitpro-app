PORT=5000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fitcore_db
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_SSL=false

# JWT
JWT_SECRET=fitcore_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=fitcore_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (optional - for avatar upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
